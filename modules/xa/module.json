{
  "name": "xa",
  "title": "Chính quyền cấp xã: một cửa, Kênh người dân, cán bộ xã",
  "version": "0.2.0",
  "db": [
    "db/01-schema.sql",
    "db/03-api.sql",
    "db/seed.sql",
    "db/02-ai-knowledge.sql",
    "db/03-citizen-chat-history.sql",
    "db/04-citizen-personalization.sql",
    "db/05-citizen-representation-counter.sql",
    "db/06-citizen-assistance-family-consultation.sql",
    "db/07-citizen-handoff-support.sql",
    "db/08-api-can-bo.sql",
    "db/09-api-xu-ly-ho-so.sql",
    "db/10-ledger.sql",
    "db/11-citizen-guidance-batches.sql",
    "db/11-workflow.sql",
    "db/12-citizen-case-review-counter.sql",
    "db/13-citizen-case-actions-delivery-routing.sql",
    "db/13-thu-tuc-theo-xa.sql",
    "db/14-luu-tru-tep.sql",
    "db/15-citizen-vault-autofill.sql",
    "db/16-citizen-procedure-privacy.sql",
    "db/17-citizen-intelligent-services.sql",
    "db/18-citizen-life-journeys.sql",
    "db/17-nhan-vien.sql",
    "db/19-citizen-rest-api.sql",
    "db/20-citizen-procedure-lock.sql",
    "db/21-citizen-api-core-flow.sql",
    "db/22-ai-knowledge-vectors.sql",
    "db/23-staff-notifications.sql",
    "db/24-staff-guide.sql",
    "db/26-citizen-staff-api.sql",
    "db/27-citizen-api-vault.sql",
    "db/28-citizen-api-case.sql",
    "db/29-citizen-api-representation.sql",
    "db/30-citizen-api-appointment.sql",
    "db/31-citizen-api-support.sql",
    "db/32-citizen-api-personal.sql",
    "db/33-citizen-api-public.sql",
    "db/34-citizen-direct-access.sql",
    "db/35-account-onboarding.sql",
    "db/36-workflow-expected-status.sql",
    "db/37-bat-goi-xa.sql",
    "db/25-api-comments.sql"
  ],
  "identity": "identity/realm.json",
  "registration": {
    "client": "citizen-app",
    "clientSecretEnv": "CITIZEN_KEYCLOAK_SECRET",
    "role": "citizen",
    "rpc": "system_register_citizen",
    "undoRpc": "system_unregister_citizen",
    "undoArg": "p_citizen_id",
    "idField": "citizen_id",
    "attributes": { "citizen_id": "citizen_id", "citizen_tenant": "tenant_code" },
    "idClaim": "citizen_id",
    "tenantClaim": "citizen_tenant",
    "notice": "Đã tạo tài khoản. Bạn có thể đăng nhập Kênh người dân bằng tên đăng nhập và mật khẩu vừa đặt."
  },
  "publicRpc": [
    "procedure_catalog",
    "procedure_detail",
    "public_knowledge",
    "public_knowledge_search",
    "public_knowledge_status",
    "public_provenance",
    "public_procedure_versions",
    "public_procedure_guide_source",
    "public_procedure_channels",
    "public_guidance_rules",
    "public_recommendation_catalog",
    "public_journey_catalog",
    "public_localities",
    "public_counter_session",
    "public_counter_session_start",
    "public_counter_session_end",
    "public_result_verification",
    "public_registration_tenants"
  ],
  "files": [
    {
      "method": "POST", "path": "dossiers/{id}/documents", "rpc": "register_document",
      "query": { "code": { "pattern": "^[a-z0-9-]{1,100}$", "required": true }, "name": { "max": 180, "default": "tep-dinh-kem" } },
      "args": { "dossier_id": "{id}", "document_code": "{code}", "original_name": "{name}" }
    },
    { "method": "GET", "path": "documents/{id:uuid}", "rpc": "document_object", "args": { "document_id": "{id}" } },
    {
      "method": "POST", "path": "staff-documents", "rpc": "request_document_add",
      "query": { "doc_type": { "pattern": "^[a-z-]{2,30}$", "required": true }, "title": { "max": 160, "default": "" }, "note": { "max": 1000 } },
      "args": { "doc_type": "{doc_type}", "title": "{title}", "note": "{note}" }
    },
    { "method": "GET", "path": "staff-documents/{id:uuid}", "rpc": "staff_document_object", "args": { "document_id": "{id}" } },
    {
      "method": "GET", "path": "handoffs/{handoffId:uuid}/documents/{documentId:uuid}", "rpc": "citizen_handoff_document",
      "args": { "p_handoff_id": "{handoffId}", "p_document_id": "{documentId}" }
    }
  ],
  "knowledgeProvider": {
    "search": "knowledge_search",
    "pending": "ai_pending_chunks",
    "store": "ai_store_embeddings",
    "status": "ai_index_status"
  },
  "workflows": [
    {
      "name": "dossiers",
      "label": "Hồ sơ",
      "processKey": "xu-ly-ho-so",
      "view": "dossiers",
      "statusRpc": "set_dossier_status",
      "idParam": "dossier_id",
      "final": ["completed", "rejected"],
      "variables": { "tenant": "tenant_code", "procedure": "procedure_id" }
    }
  ],
  "jobs": [
    { "name": "nhắc việc", "rpc": "system_dispatch_citizen_reminders", "everyMinutes": 60, "enabledBy": "CITIZEN_REMINDERS_ENABLED" },
    { "name": "rà soát lưu trữ", "rpc": "system_scan_citizen_retention", "everyMinutes": 1440, "enabledBy": "CITIZEN_RETENTION_SCAN_ENABLED" }
  ]
}
