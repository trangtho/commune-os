<script setup lang="ts">
import { Home,FilePlus2,FolderOpen,Search,Bell,UserRound,ChevronDown,BookOpen,Building2,Baby,House,Store,Layers3,ShieldCheck,MoreHorizontal,Headset,HelpCircle,MessageCircle,Phone,Menu,LogIn,LogOut,CheckCircle2,UploadCloud,FileText,ArrowRight } from 'lucide-vue-next'
const route=useRoute();const config=useRuntimeConfig();const showMobile=ref(false)
const mainScroll=ref<HTMLElement|null>(null)
const {data:auth,refresh:refreshAuth}=await useAsyncData('citizen-auth',()=>useRequestFetch()<{authenticated:boolean;name?:string}>('/api/auth/me'),{default:()=>({authenticated:false})})
const nav=[{to:'/',name:'Trang chủ',icon:Home},{to:'/thu-tuc',name:'Nộp hồ sơ trực tuyến',icon:FilePlus2},{to:'/ho-so',name:'Hồ sơ của tôi',icon:FolderOpen},{to:'/tra-cuu',name:'Tra cứu tiến độ',icon:Search},{to:'/thong-bao',name:'Thông báo',icon:Bell}]
const categories=[{name:'Tất cả lĩnh vực',icon:Layers3,to:'/thu-tuc'}, {name:'Hộ tịch',icon:Baby,to:'/thu-tuc?category=Hộ tịch'},{name:'Cư trú',icon:House,to:'/thu-tuc?category=Cư trú'},{name:'Kinh doanh',icon:Store,to:'/thu-tuc?category=Kinh doanh'},{name:'Đất đai – Xây dựng',icon:Building2,to:'/thu-tuc?category=Đất đai – Xây dựng'},{name:'Chứng thực',icon:ShieldCheck,to:'/thu-tuc?category=Chứng thực'}]
const header=computed(()=>({
 '/':'Cổng dịch vụ hành chính công cấp xã','/thu-tuc':'Danh mục thủ tục hành chính','/ho-so':'Hồ sơ của tôi',
 '/tra-cuu':'Tra cứu tiến độ hồ sơ','/thong-bao':'Thông báo','/tro-ly':'Trợ lý hướng dẫn','/huong-dan':'Hướng dẫn sử dụng','/ho-so-ca-nhan':'Hồ sơ cá nhân','/bao-mat':'Bảo mật tài khoản','/lien-he':'Liên hệ và phản hồi'
})[route.path]||(route.path.startsWith('/thu-tuc/')?'Chi tiết thủ tục':route.path.startsWith('/nop-ho-so/')?'Nộp hồ sơ trực tuyến':route.path.includes('/bo-sung')?'Bổ sung hồ sơ':route.path.includes('/ket-qua')?'Nhận kết quả điện tử':route.path.startsWith('/ho-so/')?'Chi tiết hồ sơ':'Dịch vụ công dân'))
const description=computed(()=>route.path==='/'?'Nộp hồ sơ trực tuyến, theo dõi tiến độ và nhận kết quả một cách minh bạch.':route.path.startsWith('/nop-ho-so/')?'Khai báo thông tin, tải tài liệu, rà soát và gửi hồ sơ.':'Thao tác thuận tiện, theo dõi minh bạch và an toàn với dữ liệu mô phỏng.')
const steps=computed(()=>[
  {title:'Chọn thủ tục',desc:'Tìm và chọn thủ tục cần thực hiện',icon:FileText},
  {title:'Điền thông tin',desc:'Khai báo đầy đủ theo mẫu',icon:FilePlus2},
  {title:'Tải tài liệu',desc:'Đính kèm giấy tờ theo yêu cầu',icon:UploadCloud},
  {title:'Xác nhận & nộp',desc:'Kiểm tra và gửi hồ sơ',icon:CheckCircle2},
  ...(route.path==='/'?[{title:'Theo dõi kết quả',desc:'Tra cứu, nhận kết quả điện tử',icon:FolderOpen}]:[])
])
const currentStep=computed(()=>Number(route.query.step)|| (route.path.startsWith('/nop-ho-so/')?2:1))
function isActive(path:string){return path==='/'?route.path==='/':route.path===path||route.path.startsWith(`${path}/`)}
// The browser viewport stays still; reset only the inner reading area on navigation.
watch(()=>route.fullPath,async()=>{
  showMobile.value=false
  await nextTick()
  if (mainScroll.value) mainScroll.value.scrollTop=0
})
async function logout(){await $fetch('/api/auth/logout',{method:'POST'});await refreshAuth();await navigateTo('/dang-nhap')}
</script>
<template>
 <div class="citizen-app-shell flex h-[100dvh] min-h-0 w-full max-w-full flex-col overflow-hidden">
  <header class="relative z-40 shrink-0 border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur">
   <div class="mx-auto flex h-[64px] w-full max-w-[1850px] items-center gap-1 px-2 sm:h-[68px] sm:gap-3 sm:px-4 xl:px-7">
    <NuxtLink to="/" class="flex min-w-0 shrink-0 items-center gap-1.5 sm:gap-3"><div class="grid h-9 w-9 shrink-0 place-items-center rounded-full border-[3px] border-yellow-400 bg-red-600 text-lg text-yellow-300 shadow-sm sm:h-12 sm:w-12 sm:border-4 sm:text-2xl">★</div><div class="min-w-0 leading-tight"><div class="text-[16px] font-black tracking-tight text-brand-800 sm:text-[22px]">CommuneOS</div><div class="text-[10px] font-semibold text-brand-900 sm:text-xs">Chính quyền số cấp xã</div></div></NuxtLink>
    <div class="mx-3 hidden h-9 border-l border-slate-300 2xl:block"/><p class="hidden whitespace-nowrap text-[13px] font-semibold text-slate-700 2xl:block">Cổng dịch vụ hành chính công cấp xã</p>
    <nav class="ml-auto hidden min-w-0 items-center gap-0.5 2xl:flex"><NuxtLink v-for="item in nav" :key="item.to" :to="item.to" :class="['nav-link',isActive(item.to)?'nav-link-active':'']"><component :is="item.icon" :size="17"/>{{item.name}}</NuxtLink></nav>
    <div class="ml-auto flex shrink-0 items-center gap-0.5 sm:gap-2 2xl:ml-1"><NuxtLink to="/thong-bao" class="relative rounded-lg p-1.5 text-brand-800 hover:bg-brand-50 sm:p-2" aria-label="Thông báo"><Bell :size="21"/><span class="absolute right-0 top-0 h-2 w-2 rounded-full bg-rose-500"/></NuxtLink><NuxtLink v-if="!auth?.authenticated" to="/dang-nhap" class="btn-outline"><LogIn :size="16"/>Đăng nhập</NuxtLink><div v-else class="group relative"><button class="flex items-center gap-1 rounded-lg px-1 py-1.5 hover:bg-brand-50 sm:gap-2 sm:px-2"><span class="grid h-8 w-8 place-items-center rounded-full bg-brand-100 text-brand-700 sm:h-9 sm:w-9"><UserRound :size="19"/></span><span class="hidden max-w-32 truncate text-left text-sm font-bold xl:block">{{auth.name}}<small class="block text-[11px] font-normal text-slate-500">Công dân</small></span><ChevronDown class="hidden sm:block" :size="15"/></button><div class="invisible absolute right-0 w-52 rounded-xl border bg-white p-1 shadow-lg group-hover:visible group-focus-within:visible"><NuxtLink to="/ho-so-ca-nhan" class="side-link"><UserRound :size="16"/>Hồ sơ cá nhân</NuxtLink><NuxtLink to="/bao-mat" class="side-link"><ShieldCheck :size="16"/>Bảo mật</NuxtLink><button class="side-link w-full text-left" @click="logout"><LogOut :size="16"/>Đăng xuất</button></div></div><button class="rounded-lg border p-1.5 sm:p-2 2xl:hidden" aria-label="Mở menu" aria-controls="citizen-mobile-menu" :aria-expanded="showMobile" @click="showMobile=!showMobile"><Menu :size="21"/></button></div>
   </div>
   <nav v-if="showMobile" id="citizen-mobile-menu" class="scrollbar-hide absolute inset-x-0 top-full z-50 grid max-h-[min(65svh,440px)] grid-cols-1 gap-1 overflow-y-auto border-t bg-white p-2 shadow-xl sm:grid-cols-2 sm:p-3 2xl:hidden"><NuxtLink v-for="item in nav" :key="item.to" :to="item.to" class="side-link" @click="showMobile=false"><component :is="item.icon" :size="16"/>{{item.name}}</NuxtLink></nav>
  </header>
  <section class="hero-gradient hero-pattern relative z-10 shrink-0 overflow-hidden text-white">
   <div class="pointer-events-none absolute inset-y-0 right-0 w-[78%] opacity-25 sm:w-[65%] sm:opacity-60 lg:w-[56%] lg:opacity-95"><img src="/images/ubnd-hero.png" alt="Hình minh họa trụ sở UBND xã" class="hero-building h-full w-full object-cover object-center"/></div>
   <div class="relative mx-auto max-w-[1850px] px-3 pb-4 pt-5 sm:px-5 sm:pb-5 sm:pt-7 lg:px-8 lg:pt-8"><div class="relative z-10 min-h-[85px] sm:min-h-[94px]"><h1 class="max-w-[90%] text-[23px] font-extrabold leading-tight tracking-tight sm:max-w-none sm:text-[34px]">{{header}}</h1><p class="mt-2 max-w-[690px] text-xs leading-relaxed text-blue-50 sm:text-[15px]">{{description}}</p></div>
    <div  :class="['scrollbar-hide relative z-10 flex snap-x snap-mandatory gap-1 overflow-x-auto rounded-[17px] border border-blue-100 bg-blue-50/95 p-2 text-ink shadow-lg sm:grid sm:overflow-visible sm:grid-cols-2',route.path==='/'?'lg:grid-cols-3 2xl:grid-cols-5':'lg:grid-cols-2 xl:grid-cols-4']"><div v-for="(step,index) in steps" :key="step.title" :class="['flex min-w-[220px] shrink-0 snap-start items-center gap-2 rounded-xl p-2 sm:min-w-0 sm:shrink sm:gap-3 sm:p-2.5',currentStep===index+1?'bg-[#ddecff]':'']"><span :class="['grid h-11 w-11 shrink-0 place-items-center rounded-full border',currentStep===index+1?'border-brand-600 bg-brand-600 text-white':'border-brand-200 bg-white text-brand-700']"><component :is="step.icon" :size="22"/></span><div class="min-w-0"><p class="text-sm font-bold">{{index+1}}. {{step.title}}</p><p class="text-[11px] text-slate-600">{{step.desc}}</p></div><ArrowRight v-if="index<steps.length-1" class="ml-auto hidden shrink-0 text-brand-700 xl:block" :size="14"/></div></div>
   </div>
  </section>
  <div class="citizen-workspace mx-auto grid min-h-0 w-full max-w-[1850px] min-w-0 flex-1 grid-cols-1 grid-rows-[minmax(0,1fr)] gap-4 overflow-hidden px-3 py-3 sm:px-5 xl:grid-cols-[205px_minmax(0,1fr)] xl:gap-5 2xl:grid-cols-[220px_minmax(0,1fr)_280px]">
   <aside class="citizen-inner-scroll scrollbar-hide hidden min-h-0 min-w-0 self-stretch overflow-y-auto overscroll-contain rounded-2xl border border-[#dce7f6] bg-white p-3 xl:block"><div class="space-y-1"><NuxtLink v-for="item in categories" :key="item.name" :to="item.to" :class="['side-link',route.path.startsWith('/thu-tuc')&&decodeURI(route.fullPath).includes(item.name)?'side-link-active':'']"><component :is="item.icon" :size="18"/><span class="flex-1">{{item.name}}</span></NuxtLink></div><div class="my-4 border-b border-slate-100"/><div class="space-y-1"><NuxtLink to="/ho-so" class="side-link"><FolderOpen :size="18"/>Hồ sơ của tôi</NuxtLink><NuxtLink to="/thong-bao" class="side-link"><Bell :size="18"/>Thông báo</NuxtLink><NuxtLink to="/ho-so-ca-nhan" class="side-link"><UserRound :size="18"/>Hồ sơ cá nhân</NuxtLink><NuxtLink to="/huong-dan" class="side-link"><BookOpen :size="18"/>Hướng dẫn</NuxtLink><NuxtLink to="/lien-he" class="side-link"><Headset :size="18"/>Liên hệ hỗ trợ</NuxtLink></div><p class="mt-9 rounded-lg bg-brand-50 p-3 text-xs leading-relaxed text-brand-800">Dữ liệu trong bản dựng này đều là dữ liệu giả lập, không phải hồ sơ hành chính có giá trị pháp lý.</p></aside>
   <main ref="mainScroll" class="citizen-inner-scroll scrollbar-hide min-h-0 min-w-0 max-w-full overflow-x-hidden overflow-y-auto overscroll-contain pb-5 pr-1" tabindex="0" aria-label="Nội dung chính, cuộn để xem thêm"><slot/></main>
   <aside class="citizen-inner-scroll scrollbar-hide hidden min-h-0 min-w-0 self-stretch space-y-3 overflow-y-auto overscroll-contain 2xl:block"><div class="panel overflow-hidden"><img src="/images/support.png" alt="Nhân viên hỗ trợ công dân" class="h-36 w-full bg-blue-50 object-cover"/><div class="p-4"><h3 class="text-xl font-black">Bạn cần hỗ trợ?</h3><p class="mt-1 text-xs leading-relaxed text-muted">Hướng dẫn cách nộp hồ sơ trực tuyến và theo dõi kết quả.</p><NuxtLink to="/huong-dan" class="side-link !px-0"><BookOpen :size="17"/>Hướng dẫn sử dụng <ChevronDown class="ml-auto -rotate-90" :size="15"/></NuxtLink><NuxtLink to="/tro-ly" class="side-link !px-0"><MessageCircle :size="17"/>Trợ lý hướng dẫn <ChevronDown class="ml-auto -rotate-90" :size="15"/></NuxtLink><NuxtLink to="/lien-he" class="side-link !px-0"><Headset :size="17"/>Liên hệ hỗ trợ <ChevronDown class="ml-auto -rotate-90" :size="15"/></NuxtLink></div></div><div class="panel p-4"><h3 class="mb-2 text-base font-bold text-brand-800">Trợ lý CommuneOS</h3><p class="mb-3 text-xs leading-relaxed text-muted">Tra cứu câu hỏi thường gặp từ dữ liệu mẫu; chưa tích hợp AI RAG.</p><NuxtLink class="btn-primary w-full !text-xs" to="/tro-ly"><MessageCircle :size="15"/>Bắt đầu hỏi đáp</NuxtLink></div><div class="rounded-xl border border-blue-100 bg-[#e6f3ff] p-4"><div class="mb-1 flex items-center gap-2 text-sm font-bold"><Phone :size="18"/>Hỗ trợ công dân</div><p class="text-xs text-muted">Kênh hỗ trợ mô phỏng</p><NuxtLink to="/lien-he" class="mt-1 block text-lg font-extrabold text-brand-700">Gửi yêu cầu trực tuyến</NuxtLink></div></aside>
  </div>
  <footer class="hidden shrink-0 border-t border-slate-200 bg-white px-4 py-1 text-center text-[10px] text-slate-500 2xl:block">CommuneOS Open-Core · Bản mô phỏng chức năng Công dân · PostgreSQL · Nuxt + Tailwind CSS · Apache-2.0</footer>
 </div>
</template>
