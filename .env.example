# SPDX-FileCopyrightText: 2026 CommuneOS Contributors
# SPDX-License-Identifier: Apache-2.0
#
# Tạo .env:  make secrets   (chép tệp này thành .env và sinh ngẫu nhiên mọi mật khẩu, khóa bí mật)
#      hoặc:  cp .env.example .env   rồi tự sửa giá trị.
# Tệp .env KHÔNG được đưa lên kho mã. Cài trên máy chủ cho máy khác truy cập: xem core/ops/README.md.

# ===== Địa chỉ truy cập =====
# Địa chỉ người dùng gõ vào trình duyệt: localhost (máy phát triển), IP mạng nội bộ (192.168.1.10) hoặc tên miền.
COMMUNEOS_DOMAIN=localhost
# HTTPS cho máy chủ (proxy Caddy, tự cấp chứng chỉ): bỏ dấu # ở dòng dưới rồi chạy make secrets (tự đặt địa chỉ
# công khai của Keycloak và ba ứng dụng). Người dùng vào https://<địa chỉ> (người dân), :8443 (cán bộ), :8444 (quản
# trị), :8445 (API), :8446 (Keycloak).
#COMPOSE_PROFILES=https

# Gói nghiệp vụ chạy trên lõi (thư mục modules/), cách nhau bằng dấu phẩy, theo thứ tự cài.
#   xa           : chính quyền cấp xã (Kênh người dân, màn hình cán bộ, bảng quản trị dùng gói này)
#   doanh-nghiep : ví dụ doanh nghiệp duyệt đơn nghỉ phép
# Để rỗng (COMMUNEOS_MODULES=) thì chỉ chạy lõi, chưa có gói nào; thêm gói sau rồi make up là được.
# Bỏ một gói khỏi danh sách chỉ ngừng nạp gói đó, không xóa dữ liệu đã có. Đổi xong chạy make up.
COMMUNEOS_MODULES=xa,doanh-nghiep

# Cơ sở dữ liệu
POSTGRES_DB=communeos
POSTGRES_USER=communeos
POSTGRES_PASSWORD=doi-mat-khau-nay

# Tài khoản quản trị Keycloak (dùng từ ngày 2)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-nay

# Tài khoản quản trị hệ thống CommuneOS: tài khoản DUY NHẤT có sẵn sau khi cài, đăng nhập bảng quản trị (cổng 3001)
# để tạo xã và tài khoản lãnh đạo xã. Bắt buộc đổi mật khẩu: tối thiểu 10 ký tự, có chữ và số; make up từ chối mật
# khẩu mẫu dưới đây. Mỗi lần make up, mật khẩu được đặt lại theo .env: muốn đổi thì sửa ở đây rồi make up.
COMMUNEOS_ADMIN_USERNAME=quantri
COMMUNEOS_ADMIN_PASSWORD=doi-mat-khau-nay

# Cổng mở ra ngoài của cửa ngõ API
GATEWAY_PORT=9080

# Địa chỉ công khai của Keycloak (nơi cấp ghi trong token). Để trống: http://<COMMUNEOS_DOMAIN>:8080; bật HTTPS thì
# make secrets đặt https://<COMMUNEOS_DOMAIN>:8446.
KEYCLOAK_PUBLIC_URL=

# Cấu hình Kênh Công dân (Nuxt 3)
# Mật khẩu vai trò PostgreSQL của ứng dụng (khác POSTGRES_PASSWORD)
POSTGRES_APP_PASSWORD=doi-mat-khau-ung-dung

# Mật khẩu vai trò authenticator của API dữ liệu (PostgREST); khác 2 mật khẩu trên
POSTGRES_REST_PASSWORD=doi-mat-khau-api

# Cổng PostgreSQL chỉ mở tại máy phát triển
POSTGRES_PORT=5432

# Cổng Kênh Công dân (mặc định chỉ mở tại máy phát triển)
CITIZEN_PORT=3000

# Khóa bí mật phiên đăng nhập; tạo bằng: openssl rand -hex 32
SESSION_SECRET=THAY_BANG_CHUOI_HEX_NGAU_NHIEN_DU_64_KY_TU
# Chỉ bật khi demo HTTP trên localhost hoặc IP IPv4 nội bộ (RFC1918); không dùng dữ liệu thật.
# HTTPS và mọi địa chỉ công cộng vẫn yêu cầu cookie Secure.
PORTAL_ALLOW_LOCAL_HTTP=false
# Cổng http của ba ứng dụng (3000-3002), cổng API (9080), Keycloak (8080) mở trên địa chỉ nào: 127.0.0.1 chỉ máy này
# (mặc định, cả khi bật HTTPS); mạng nội bộ dùng http thì đặt IP LAN của máy chủ và PORTAL_ALLOW_LOCAL_HTTP=true.
# Mở cho máy khác thì make check-env bắt đổi hết bí mật mẫu (make secrets).
PORTAL_BIND_ADDRESS=127.0.0.1
# Origin công khai chính xác của từng portal khi đặt sau reverse proxy (gồm scheme, host, port nếu có).
# Để trống nếu truy cập trực tiếp. Không thêm đường dẫn; không dùng chung origin cho ba portal. Bật HTTPS bằng proxy
# của CommuneOS (COMPOSE_PROFILES=https) thì make secrets tự đặt.
CITIZEN_PORTAL_PUBLIC_ORIGIN=
COMMUNE_PORTAL_PUBLIC_ORIGIN=
ADMIN_PORTAL_PUBLIC_ORIGIN=

# Tuỳ chọn: chỉ bật khi nhóm có kết nối định danh OIDC được cơ quan có thẩm quyền phê duyệt.
# Không bật provider=vneid và APPROVED=true trên môi trường demo/chưa được chấp thuận.
CITIZEN_OIDC_PROVIDER=identity
CITIZEN_VNEID_INTEGRATION_APPROVED=false
CITIZEN_OIDC_ISSUER=
CITIZEN_OIDC_AUTHORIZE_URL=
CITIZEN_OIDC_TOKEN_URL=
CITIZEN_OIDC_JWKS_URL=
CITIZEN_OIDC_CLIENT_ID=
CITIZEN_OIDC_CLIENT_SECRET=
CITIZEN_OIDC_REDIRECT_URI=

# Các tên claim/scope này là hợp đồng riêng của Identity, KHÔNG phải chuẩn mặc định VNeID.
CITIZEN_OIDC_RESIDENCE_TENANT_CLAIM=
CITIZEN_OIDC_TEMPORARY_TENANT_CLAIM=
CITIZEN_OIDC_LOCALITY_SCOPE=

# Giấy phép và ánh xạ thuộc tính cá nhân: tắt mặc định. KHÔNG khai là VNeID nếu chưa có hợp đồng.
# Chỉ bật khi hợp đồng chia sẻ thuộc tính cá nhân đã được phê duyệt,
# và công dân tích chọn đồng ý khi đăng nhập.
CITIZEN_OIDC_PERSONAL_DATA_APPROVED=false
CITIZEN_OIDC_PERSONAL_DATA_SCOPE=
CITIZEN_OIDC_NAME_CLAIM=
CITIZEN_OIDC_BIRTH_DATE_CLAIM=
CITIZEN_OIDC_IDENTIFIER_CLAIM=
CITIZEN_OIDC_PHONE_CLAIM=
CITIZEN_OIDC_ADDRESS_CLAIM=

# Cổng màn hình cán bộ xã (mặc định chỉ mở tại máy phát triển)
COMMUNE_PORT=3002

# Cổng bảng quản trị hệ thống (mặc định chỉ mở tại máy phát triển)
ADMIN_PORT=3001


# Động cơ quy trình (Flowable) và dịch vụ điều phối
# Mật khẩu tài khoản rest-admin của Flowable (chỉ dịch vụ điều phối dùng)
FLOWABLE_ADMIN_PASSWORD=doi-mat-khau-flowable
# Bí mật để cơ sở dữ liệu nhận ra lời gọi từ dịch vụ điều phối; tạo bằng: openssl rand -hex 32
WORKFLOW_TOKEN=THAY_BANG_CHUOI_HEX_NGAU_NHIEN

# Kho đối tượng (SeaweedFS) và dịch vụ tệp của lõi. Đổi khi chạy thật: openssl rand -hex 24
S3_ACCESS_KEY=communeos
S3_SECRET_KEY=doi-khoa-nay-khi-chay-that
FILES_SERVICE_TOKEN=doi-khoa-nay-khi-chay-that
# Bật quét mã độc: CLAMAV_HOST=antivirus (cần chạy dịch vụ antivirus)
CLAMAV_HOST=

# Quét hằng ngày dữ liệu đến hạn rà soát lưu trữ (dịch vụ điều phối của lõi chạy; chỉ tạo mục chờ lãnh đạo xã xem xét,
# không xóa tệp nào). Tắt mặc định.
CITIZEN_RETENTION_SCAN_ENABLED=false

# HTTPS origin for result QR codes; never point to an untrusted host.
CITIZEN_PUBLIC_ORIGIN=
# Optional authorized electronic-result provider for QR validation (server-side only).
# Example: https://results.example.gov.vn/api
CITIZEN_RESULTS_ENDPOINT=
CITIZEN_RESULTS_TOKEN=
# Explicit opt-in OCR provider: HTTPS JSON/multipart service with Bearer token. Off by default.
CITIZEN_OCR_ENDPOINT=
CITIZEN_OCR_TOKEN=

# Gửi nhắc việc trong ứng dụng mỗi giờ (dịch vụ điều phối của lõi chạy); tắt mặc định, công dân cũng phải tự bật.
CITIZEN_REMINDERS_ENABLED=false
# Bí mật của client accounts-service (dịch vụ tài khoản cán bộ). Đổi: openssl rand -hex 24
KEYCLOAK_ACCOUNTS_SECRET=doi-khoa-nay-khi-chay-that
# Bí mật của client citizen-app: chỉ máy chủ Kênh người dân xin được token công dân. Đổi: openssl rand -hex 24
CITIZEN_KEYCLOAK_SECRET=doi-khoa-nay-khi-chay-that

# Trí tuệ nhân tạo chạy cục bộ (core/ai). Để trống dùng mặc định; mô hình tự tải ở lần make up đầu tiên.
# Máy chủ mạnh hoặc có GPU: AI_CHAT_MODEL=qwen3:4b hoặc qwen3:8b. Mô hình nhúng phải cho vector 1024 chiều.
AI_CHAT_MODEL=
AI_EMBED_MODEL=
