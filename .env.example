#
# Sao tệp này thành .env rồi sửa giá trị:  cp .env.example .env
# Tệp .env KHÔNG được đưa lên kho mã.

# Địa chỉ công khai của cửa ngõ API
PUBLIC_URL=http://localhost:9080

# Cơ sở dữ liệu
POSTGRES_DB=communeos
POSTGRES_USER=communeos
POSTGRES_PASSWORD=doi-mat-khau-nay

# Tài khoản quản trị Keycloak (dùng từ ngày 2)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-nay

# Cổng mở ra ngoài của cửa ngõ API
GATEWAY_PORT=9080

# Địa chỉ công khai của Keycloak (nơi cấp ghi trong token)
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Cấu hình Kênh Công dân (Nuxt 3)
# Mật khẩu vai trò PostgreSQL của ứng dụng (khác POSTGRES_PASSWORD)
POSTGRES_APP_PASSWORD=doi-mat-khau-ung-dung

# Mật khẩu vai trò authenticator của API dữ liệu (PostgREST); khác 2 mật khẩu trên
POSTGRES_REST_PASSWORD=doi-mat-khau-api

# Cổng PostgreSQL chỉ mở tại máy phát triển
POSTGRES_PORT=5432

# Cổng Kênh Công dân chỉ mở tại máy phát triển
CITIZEN_PORT=3000

# Khóa bí mật phiên đăng nhập; tạo bằng: openssl rand -hex 32
SESSION_SECRET=THAY_BANG_CHUOI_HEX_NGAU_NHIEN_DU_64_KY_TU

# Tuỳ chọn: chỉ bật khi nhóm có kết nối định danh OIDC được cơ quan có thẩm quyền phê duyệt.
# Không bật provider=vneid và APPROVED=true trên môi trường demo/chưa được chấp thuận.
CITIZEN_OIDC_PROVIDER=identity
CITIZEN_VNEID_INTEGRATION_APPROVED=false
CITIZEN_OIDC_ISSUER=
CITIZEN_OIDC_AUTHORIZE_URL=
CITIZEN_OIDC_TOKEN_URL=
CITIZEN_OIDC_JWKS_URL=
CITIZEN_OIDC_CLIENT_ID=
CITIZEN_OIDC_CLIENT_SECRET=
CITIZEN_OIDC_REDIRECT_URI=

# Các tên claim/scope này là hợp đồng riêng của Identity, KHÔNG phải chuẩn mặc định VNeID.
CITIZEN_OIDC_RESIDENCE_TENANT_CLAIM=
CITIZEN_OIDC_TEMPORARY_TENANT_CLAIM=
CITIZEN_OIDC_LOCALITY_SCOPE=

# Tuỳ chọn: chỉ dùng giữa backend Kênh công dân và backend cán bộ được xác thực.
# Sinh bằng `openssl rand -hex 32`; để trống cho đến khi cán bộ triển khai integration.
CITIZEN_STAFF_BRIDGE_TOKEN=
