# Copy to .env. NEVER commit your actual .env file.
PUBLIC_URL=http://localhost:3000
POSTGRES_DB=communeos
POSTGRES_USER=communeos
POSTGRES_PASSWORD=CHANGE_ME_DB_SUPERUSER
POSTGRES_APP_PASSWORD=CHANGE_ME_DB_APP_ROLE
POSTGRES_PORT=5432
CITIZEN_PORT=3000
# At least 32 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS_FROM_OPENSSL
# Planned core identity provider (NOT in this citizen prototype)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK
