# Sao tệp này thành .env rồi sửa giá trị:  cp .env.example .env
# Tệp .env KHÔNG được đưa lên kho mã.

# Địa chỉ công khai của cửa ngõ API
PUBLIC_URL=http://localhost:9080

# Cơ sở dữ liệu
POSTGRES_DB=communeos
POSTGRES_USER=communeos
POSTGRES_PASSWORD=doi-mat-khau-nay

# Tài khoản quản trị Keycloak (dùng từ ngày 2)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-nay

# Cổng mở ra ngoài của cửa ngõ API
GATEWAY_PORT=9080

# Địa chỉ công khai của Keycloak (nơi cấp ghi trong token)
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Cấu hình Kênh Công dân (Nuxt 3)
# Mật khẩu vai trò PostgreSQL của ứng dụng (khác POSTGRES_PASSWORD)
POSTGRES_APP_PASSWORD=doi-mat-khau-ung-dung

# Cổng PostgreSQL chỉ mở tại máy phát triển
POSTGRES_PORT=5432

# Cổng Kênh Công dân chỉ mở tại máy phát triển
CITIZEN_PORT=3000

# Khóa bí mật phiên đăng nhập; tạo bằng: openssl rand -hex 32
SESSION_SECRET=THAY_BANG_CHUOI_HEX_NGAU_NHIEN_DU_64_KY_TU
