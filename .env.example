# Sao tệp này thành .env rồi sửa giá trị:  cp .env.example .env
# Tệp .env KHÔNG được đưa lên kho mã.

# Địa chỉ công khai của cửa ngõ API
PUBLIC_URL=http://localhost:9080

# Cơ sở dữ liệu
POSTGRES_DB=communeos
POSTGRES_USER=communeos
POSTGRES_PASSWORD=doi-mat-khau-nay

# Tài khoản quản trị Keycloak (dùng từ ngày 2)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=doi-mat-khau-nay

GATEWAY_PORT=9080